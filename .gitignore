# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — generated client is build output, never commit it
/src/generated

# local SQLite file, used to author migrations and for offline dev.
# Production data lives in Turso. Kept at the project root so the Prisma CLI and
# src/lib/db.ts resolve to the SAME file — see prisma/MIGRATIONS.md.
/dev.db
/dev.db-journal
/dev.db-wal
/dev.db-shm

# netlify
.netlify

# Anything *.local.* is a scratch file that may hold real credentials —
# e.g. NETLIFY-ENV.local.txt, the values pasted into the Netlify dashboard.
*.local.txt
*.local.json
